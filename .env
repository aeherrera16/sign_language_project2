# ================================
# 🔑 CONFIGURACIÓN DEL SISTEMA
# ================================

# ===== LLM CON OLLAMA (GRATIS) =====
# Ollama debe estar corriendo: ollama serve
# Modelo descargado: ollama pull deepseek-r1

LLM_BASE_URL=http://localhost:11434
LLM_MODEL=deepseek-r1
DEEPSEEK_API_KEY=not_needed

# ===== SEGMENTACIÓN SEMÁNTICA =====
# Configuración de MediaPipe para segmentación pixel a pixel

# Confianza mínima para detectar manos (0.0 - 1.0)
MIN_DETECTION_CONFIDENCE=0.7

# Confianza mínima para tracking de manos (0.0 - 1.0)
MIN_TRACKING_CONFIDENCE=0.7

# Threshold para la máscara de segmentación (0.0 - 1.0)
# Valores más altos = más restrictivo (solo píxeles muy seguros)
SEGMENTATION_THRESHOLD=0.5

# Modelo de segmentación (0 = general, 1 = landscape/retrato)
SEGMENTATION_MODEL=1

# ===== CÁMARA =====
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30

# ===== MODELO DE RECONOCIMIENTO =====
MODEL_PATH=backend_full/trained_models/optimized_hands_only_model.h5
LABELS_PATH=backend_full/trained_models/optimized_labels.pkl
SCALER_PATH=backend_full/trained_models/scaler.pkl

# Confianza mínima para considerar una predicción válida
MIN_PREDICTION_CONFIDENCE=0.6

# ===== BACKEND API =====
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# ===== PATHS =====
DATA_DIR=data
GESTURES_DIR=data/gestures
PROCESSED_DIR=data/processed
UPLOADS_DIR=uploads
MODELS_DIR=models

# ===== TRAINING =====
EPOCHS=50
BATCH_SIZE=32
VALIDATION_SPLIT=0.2
LEARNING_RATE=0.001

# ===== LOGGING =====
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
