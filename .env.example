# ================================
# 🔑 CONFIGURACIÓN DE IA GENERATIVA
# ================================

# 🆓 DeepSeek R1 con Ollama (100% GRATIS, SIN PAGAR NADA)
# Instalación:
# 1. Instalar Ollama: curl -fsSL https://ollama.com/install.sh | sh
# 2. Descargar modelo: ollama pull deepseek-r1
# 3. Ejecutar servidor: ollama serve
# 4. Listo! No necesitas API key

# URL de Ollama (local o servidor remoto)
LLM_BASE_URL=http://localhost:11434

# Modelo a usar (deepseek-r1 es GRATIS y open-source)
LLM_MODEL=deepseek-r1

# API Key (NO SE NECESITA con Ollama, pero déjalo por compatibilidad)
DEEPSEEK_API_KEY=not_needed=================
# 🔑 CONFIGURACIÓN DE IA GENERATIVA
# ================================

# DeepSeek API (Recomendado - Barato y bueno)
# 1. Ve a: https://platform.deepseek.com/
# 2. Regístrate/Login
# 3. Ve a "API Keys" 
# 4. Crea una nueva key
# 5. Copia y pega aquí:
DEEPSEEK_API_KEY=sk-1fd9c833820a40c1999ad6194a6c19d5

# Base URL para DeepSeek
LLM_BASE_URL=https://api.deepseek.com/v1

# Modelo a usar
LLM_MODEL=deepseek-chat

# ================================
# 🌐 ALTERNATIVAS (si quieres usar otra cosa)
# ================================

# Si tienes Ollama en otro servidor (Oracle Cloud, etc):
# LLM_BASE_URL=http://tu-servidor-ip:11434
# LLM_MODEL=deepseek-r1

# Si quieres usar DeepSeek API de pago (NO RECOMENDADO):
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# OpenAI (de pago):
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-3.5-turbo

# ================================
# ⚙️ CONFIGURACIÓN DEL BACKEND
# ================================
HOST=0.0.0.0
PORT=8000
DEBUG=True

# ================================
# 🎯 CONFIGURACIÓN DE MODELOS
# ================================
MODEL_PATH=model/best_model.h5
LABELS_PATH=model/labels.pkl
CONFIDENCE_THRESHOLD=0.7

# ================================
# 📷 CONFIGURACIÓN DE CÁMARA
# ================================
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
FPS=30

# ================================
# 🔬 CONFIGURACIÓN DE SEGMENTACIÓN
# ================================
SEGMENTATION_MODEL=mediapipe
SEGMENTATION_THRESHOLD=0.5

# ================================
# 📝 INSTRUCCIONES RÁPIDAS
# ================================
# 1. Instala Ollama: curl -fsSL https://ollama.com/install.sh | sh
# 2. Descarga DeepSeek R1: ollama pull deepseek-r1
# 3. Ejecuta Ollama: ollama serve
# 4. Copia este archivo: cp .env.example .env
# 5. ¡Listo! Ya tienes IA GRATIS sin pagar nada
