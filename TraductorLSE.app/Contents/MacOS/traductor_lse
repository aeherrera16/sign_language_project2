#!/bin/bash
# ============================================================
#  Traductor LSE - Ejecutable de la app macOS
#  Este script es el ejecutable dentro del .app bundle.
# ============================================================

# Obtener el directorio del proyecto (3 niveles arriba del ejecutable)
DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$DIR"

# ============================================================
#  Configurar entorno si es la primera vez
# ============================================================
if [ ! -f ".venv/bin/python" ]; then
    # Mostrar diálogo nativo de macOS
    osascript -e 'display dialog "¡Bienvenido al Traductor LSE!\n\nEs la primera vez que abres la aplicación.\nSe configurará automáticamente.\n\nEsto puede tardar 5-10 minutos.\nLas próximas veces abrirá instantáneamente." buttons {"Cancelar", "Continuar"} default button "Continuar" with title "Traductor LSE" with icon caution' 2>/dev/null

    if [ $? -ne 0 ]; then
        exit 0
    fi

    # Buscar Python
    if command -v python3.10 &> /dev/null; then
        PY=python3.10
    elif command -v python3 &> /dev/null; then
        PY=python3
    else
        osascript -e 'display dialog "Python 3 no está instalado.\n\nInstálalo con:\nbrew install python@3.10\n\nO descárgalo de python.org" buttons {"OK"} default button "OK" with title "Traductor LSE - Error" with icon stop' 2>/dev/null
        exit 1
    fi

    # Crear entorno virtual
    osascript -e 'display notification "Creando entorno virtual..." with title "Traductor LSE" subtitle "Configurando (1/2)"' 2>/dev/null
    $PY -m venv .venv
    if [ $? -ne 0 ]; then
        osascript -e 'display dialog "Error al crear el entorno virtual." buttons {"OK"} default button "OK" with title "Error" with icon stop' 2>/dev/null
        exit 1
    fi

    source .venv/bin/activate

    # Instalar dependencias
    osascript -e 'display notification "Instalando dependencias (puede tardar unos minutos)..." with title "Traductor LSE" subtitle "Configurando (2/2)"' 2>/dev/null
    pip install --upgrade pip > /dev/null 2>&1
    pip install opencv-python mediapipe tensorflow pyttsx3 scikit-learn 2>&1

    if [ $? -ne 0 ]; then
        osascript -e 'display dialog "Error al instalar las dependencias.\nVerifica tu conexión a internet." buttons {"OK"} default button "OK" with title "Error" with icon stop' 2>/dev/null
        exit 1
    fi

    osascript -e 'display notification "¡Configuración completada!" with title "Traductor LSE" subtitle "Abriendo aplicación..."' 2>/dev/null
else
    source .venv/bin/activate
fi

# ============================================================
#  Silenciar warnings y abrir la app
# ============================================================
export TF_CPP_MIN_LOG_LEVEL=3
export TF_ENABLE_ONEDNN_OPTS=0
export MEDIAPIPE_DISABLE_GPU=1
export GLOG_minloglevel=3
export ABSL_MIN_LOG_LEVEL=3
export PYTHONWARNINGS="ignore"

# Lanzar el menú gráfico
exec python "$DIR/prototipo/menu.py"
